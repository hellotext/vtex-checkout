{
  "name": "@hellotext/vtex-checkout",
  "version": "0.0.1",
  "description": "Hellotext SDK for VTEX Checkout Funnel and Confirmation",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "browser": "dist/vtex-checkout.js",
  "unpkg": "dist/vtex-checkout.js",
  "types": "index.d.ts",
  "author": "Hellotext",
  "license": "MIT",
  "files": [
    "lib",
    "dist",
    "src",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./funnel": "./dist/funnel.js",
    "./confirmation": "./dist/confirmation.js"
  },
  "scripts": {
    "test": "NODE_ENV=test jest",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:bundle",
    "build:esm": "babel src -d lib",
    "build:cjs": "BABEL_ENV=cjs babel src -d lib --out-file-extension .cjs",
    "build:bundle": "webpack --mode production",
    "clean": "rm -rf lib dist",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@hellotext/hellotext": "^latest"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "babel-loader": "^9.1.2",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
